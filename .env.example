# Slack Council Bot Configuration
# Copy this file to .env and fill in your actual values after OAuth installation

# Bot user OAuth token (get from Slack app OAuth & Permissions page)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Signing secret (get from Slack app Basic Information page)
SLACK_SIGNING_SECRET=your-signing-secret-here

# App-level token (get from Slack app Basic Information > App-Level Tokens)
SLACK_APP_TOKEN=xapp-your-app-token-here

# Workspace/Team ID (get from Slack workspace settings)
SLACK_WORKSPACE_ID=T0123456789

# Team ID (identical to workspace ID for most organizations)
SLACK_TEAM_ID=T0123456789

# Default channel IDs (comma separated) for automated posts
# SLACK_CHANNEL_IDS=C0123456789,C0987654321  # Optional: Comma-separated channel IDs. Leave unset to access all channels.
