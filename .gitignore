# Slack-HQ .gitignore

# Temporary files
*.tmp
*.temp
*~
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*.local
.env.backup
.env.backup.*

# Editor directories and files
.idea/
.vscode/
*.swp
*.swo
*~

# Node modules (if we add any JavaScript tools)
node_modules/
package-lock.json

# Python virtual environments
venv/
env/
.venv/
__pycache__/
*.py[cod]

# Build outputs
dist/
build/
*.docx.tmp

# OS files
Thumbs.db
.DS_Store

# Notion exports (only keep markdown sources)
*.notion-export/

# Test files and temporary conversions
test-*.md
test-*.docx
temp-*.md
temp-*.docx

# Artifacts - track structure, ignore contents
artifacts/**/*
!artifacts/README.md
!artifacts/.gitkeep
!artifacts/chatgpt/
!artifacts/chatgpt/README.md
!artifacts/chatgpt/.gitkeep
!artifacts/claude/
!artifacts/claude/README.md
!artifacts/claude/.gitkeep

# Exception: Allow specific artifact types if needed for examples
# artifacts/**/example-*.md

# Context and cache
.context/
.cache/

# Secrets and credentials
secrets.json
credentials.json
*.key
*.pem
temp-context/secrets.md

# Claude Code runtime data
.claude/mcp.json
.claude/settings.local.json
.claude/data/

# Archived audit reports
.archive/
